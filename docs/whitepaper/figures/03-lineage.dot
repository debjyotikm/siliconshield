digraph ModelLineage {
  graph [rankdir=TB, newrank=true, splines=ortho, bgcolor="white", pad=0.25, nodesep=0.8,
    ranksep=0.65, fontname="Inter SemiBold", fontcolor="#1E3040", fontsize=20, labelloc=t,
    label="03   Two specialists, distinct training ancestries"];
  node [shape=box, style="rounded,filled", color="#8A9AA6",
    fillcolor="white", fontname="Inter", fontsize=15,
    margin="0.22,0.17", width=5.3, fontcolor="#1E3040", penwidth=1.2];
  edge [color="#647482", arrowsize=0.7, penwidth=1.3,
    fontname="Inter", fontsize=12];
  foundation [label="Untouched LAYA foundation\nPretrained encoder and decision head",
    fillcolor="#EDF2F5", color="#1E3040", width=4.7];
  subgraph cluster_local {
    label="CONTRACT-1 / LOCAL SECURITY";
    fontname="Inter SemiBold"; fontsize=14; labelloc=b; fontcolor="#2A6080";
    color="#C3D3DF"; style="rounded"; margin=22;
    security [group="left", label="Broad security training\nSource-backed and authored contracts"];
    expansion [group="left", label="OpenTitan coverage expansion\n27,033 combined TRAIN decisions"];
    specialization [group="left", label="Counterbalanced local guards\n576 TRAIN decisions\nFull encoder + adapters + head"];
    c1 [group="left", label="Contract-1\nDirect local security requirements", peripheries=2,
      fillcolor="#EAF2F7", color="#2A6080", fontcolor="#2A6080"];
    security:s -> expansion:n; expansion:s -> specialization:n; specialization:s -> c1:n;
  }
  subgraph cluster_temporal {
    label="CONTRACT-2 / TEMPORAL CONTROL";
    fontname="Inter SemiBold"; fontsize=14; labelloc=b; fontcolor="#277567";
    color="#C1D9D1"; style="rounded"; margin=22;
    fresh [group="right", label="Fresh encoder training\n10,917 Paths + Temporal decisions"];
    focused [group="right", label="Focused temporal adapters\n2,691 FIFO / counter / arbitration decisions"];
    refinement [group="right", label="Adapter refinement\nLow-rate continuation and preservation"];
    c2 [group="right", label="Contract-2\n2,700-row final triplet study\nFrozen encoder; adapters + head", peripheries=2,
      fillcolor="#ECF5F1", color="#277567", fontcolor="#277567"];
    fresh:s -> focused:n; focused:s -> refinement:n; refinement:s -> c2:n;
  }
  foundation -> security;
  foundation -> fresh;
  {rank=same; security; fresh;}
  {rank=same; expansion; focused;}
  {rank=same; specialization; refinement;}
  {rank=same; c1; c2;}
  note [shape=plaintext, width=0, fontsize=12, fontcolor="#647482",
    label="Counts describe registered populations and are not additive unique-example totals.\nContract-2 is not a continuation of Contract-1."];
  c1 -> note [style=invis];
  c2 -> note [style=invis];
}
