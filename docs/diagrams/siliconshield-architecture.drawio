        <mxCell id="note1" value="I02  Benchmarking uses the same worker protocol on a pinned population." style="html=0;whiteSpace=none;fontFamily=Inter,Arial,sans-serif;fontSize=18;fontColor=#202020;strokeWidth=1.4;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=17;fontStyle=0;" vertex="1" parent="1">
